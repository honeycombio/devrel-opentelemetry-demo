#!/bin/bash

set -e

# Captured before flag parsing consumes "$@", so the deploy marker can report
# exactly what was passed to ./run.
ORIGINAL_ARGS="$*"

# Run a setup step without its chatter, but if it fails, show what it said and stop.
# (Plain `> /dev/null 2>&1` under set -e made ./run exit silently, e.g. on an expired AWS SSO token.)
quietly() {
    local output
    if ! output=$("$@" 2>&1); then
        echo "$output" >&2
        echo "Error: '$*' failed. (Expired AWS SSO token? Try: aws sso login --profile ${AWS_PROFILE:-devrel-sandbox})" >&2
        exit 1
    fi
}

# Print one output of a Pulumi stack. Like quietly: stderr is hidden unless it fails.
# Use as VAR=$(stack_output <stack> <name>); under set -e a failure stops ./run.
stack_output() {
    local errfile value
    errfile=$(mktemp)
    if ! value=$(pulumi stack output -s "$1" "$2" 2>"$errfile"); then
        cat "$errfile" >&2
        rm -f "$errfile"
        echo "Error: couldn't read '$2' from Pulumi stack $1. (Logged out? Try: pulumi login)" >&2
        exit 1
    fi
    rm -f "$errfile"
    echo "$value"
}

# Source .skaffold.env file if it exists
if [[ -f .skaffold.env ]]; then
    set -a
    eval "$(cat '.skaffold.env')"
    set +a
fi

# Default the per-purpose keys from HONEYCOMB_API_KEY when not explicitly set.
# The collector pod expects HONEYCOMB_INGEST_KEY (events permission) and
# HONEYCOMB_MARKERS_API_KEY (markers permission) — both env vars are referenced by
# the rendered collector config, so they must be present even if they alias
# the same secret. Set HONEYCOMB_INGEST_KEY/HONEYCOMB_MARKERS_API_KEY in
# .skaffold.env to override.
export HONEYCOMB_INGEST_KEY="${HONEYCOMB_INGEST_KEY:-$HONEYCOMB_API_KEY}"
export HONEYCOMB_MARKERS_API_KEY="${HONEYCOMB_MARKERS_API_KEY:-$HONEYCOMB_API_KEY}"

# Validate Honeycomb API keys (quiet mode - only outputs on errors)
scripts/validate-honeycomb-keys.sh --quiet

# Default to AWS if no cloud provider flag is provided
CLOUD_PROVIDER="aws"
DOMAINNAME="aurelia.honeydemo.io"
INGRESS_CLASS="alb"
# Agent (Bedrock-hitting) loadgen is off by default for local clusters so
# multiple developer namespaces don't all hammer the shared AWS account.
# Pass --agent-load / -a to opt in.
AGENT_LOAD_ENABLED=""

# Parse flags (cloud and agent-load, any order)
while [[ "$1" == "--cloud" || "$1" == "-c" || "$1" == "--agent-load" || "$1" == "-a" ]]; do
    case "$1" in
        --cloud|-c)
            CLOUD_PROVIDER="$2"
            if [[ ! "$CLOUD_PROVIDER" =~ ^(aws|azure)$ ]]; then
                echo "Error: Invalid cloud provider '$CLOUD_PROVIDER'"
                echo "Usage: $0 [--cloud|-c aws|azure] [--agent-load|-a] [SERVICES...]"
                echo "Default: aws"
                exit 1
            fi
            shift 2
            ;;
        --agent-load|-a)
            # "yes" (not "true"/"1") so skaffold's helm --set keeps it a
            # string — the chart schema rejects a coerced boolean/number for
            # envOverrides[].value. The loadgen accepts true/yes/on/1.
            AGENT_LOAD_ENABLED="yes"
            shift
            ;;
    esac
done

SERVICES=$*
if [ -z "$SERVICES" ]; then
# SERVICES should contain something listed as an image in skaffold.yaml (subset of the name of an image works too)
  SERVICES="nothing-things-are-v-slow-when-you-do-this" # please specify a container
  echo "************************************"
  echo "      Using all default services    "
  echo "************************************"
fi


# Get container registry from Pulumi stack output based on cloud provider
if [[ "$CLOUD_PROVIDER" == "aws" ]]; then
    echo "Using AWS configuration"
    CONTAINER_REGISTRY=$(stack_output honeycomb-devrel/infra-aws/prod ecrRepositoryUrlPrefix)
    echo "Logging in to ECR, because it's so annoying when we forget."
    quietly scripts/login-ecr.sh

    # Pull Bedrock inference profiles + local-dev IAM role from the shared infra stack.
    BEDROCK_HAIKU_PROFILE_ARN=$(stack_output honeycomb-devrel/infra-aws/prod bedrockClaudeHaikuProfileArn)
    BEDROCK_AWS_REGION=$(stack_output honeycomb-devrel/infra-aws/prod clusterRegion)
    # TODO: source from infra stack once outputs land. Hardcoded for local testing.
    BEDROCK_NOVA_LITE_PROFILE_ARN="arn:aws:bedrock:eu-west-1:657166037864:inference-profile/eu.amazon.nova-2-lite-v1:0"
    BEDROCK_NOVA_MICRO_PROFILE_ARN="arn:aws:bedrock:eu-west-1:657166037864:inference-profile/eu.amazon.nova-micro-v1:0"
elif [[ "$CLOUD_PROVIDER" == "azure" ]]; then
    echo "Using Azure configuration"
    CONTAINER_REGISTRY=$(stack_output honeycomb-devrel/infra-azure/prod acrName)
    echo "Logging in to ACR, because it's so annoying when we forget."
    quietly scripts/login-acr.sh
    DOMAINNAME="zurelia.honeydemo.io"
    INGRESS_CLASS="webapprouting.kubernetes.azure.com"
fi

# Set kubectl context for the appropriate cloud provider
echo "Setting kubectl context for $CLOUD_PROVIDER..."
quietly scripts/set-kubecontext.sh "$CLOUD_PROVIDER"

export CLOUD_PROVIDER
export DOMAINNAME
export INGRESS_CLASS
export BEDROCK_HAIKU_PROFILE_ARN
export BEDROCK_NOVA_LITE_PROFILE_ARN
export BEDROCK_NOVA_MICRO_PROFILE_ARN
export BEDROCK_AWS_REGION
export AGENT_LOAD_ENABLED

# Build -b flags: one per service (skaffold requires separate -b flags for each image)
BUILD_FLAGS=""
for svc in $SERVICES; do
  BUILD_FLAGS="$BUILD_FLAGS -b $svc"
done

# The Honeycomb deploy marker is posted by a skaffold deploy "after" hook
# (scripts/deploy-marker-hook.sh), so it lands when the pods are ready — not
# when --port-forward finally exits. This message says exactly what was passed to ./run.
export DEPLOY_MARKER_MESSAGE="./run $ORIGINAL_ARGS -> ${USER}-local"

# maybe someday the container registry name will change, but this is what it is now
skaffold run -d "$CONTAINER_REGISTRY" $BUILD_FLAGS --port-forward=user -l skaffold.dev/run-id=static --cache-artifacts=false

# note: if the output ends with
#   Error: UPGRADE FAILED: another operation (install/upgrade/rollback) is in progress
# then do something like this:
#   helm rollback -n  jessicakerr-local jessicakerr
# maybe later I can get this to print usefully
