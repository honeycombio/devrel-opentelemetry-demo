#!/usr/bin/env bash
# AWS CLI credential_process for Amp orbs, as in the Autobots repo. Exchanges a
# fresh Amp OIDC token (https://ampcode.com/manual/orbs/oidc) for temporary
# credentials on the amp-orb-devrel-otel-demo role, which can push to the
# localdemo/* ECR repos and deploy to the demo EKS cluster. The role and its
# trust policy live in devrel-opentelemetry-demo-infra, infra-aws/amp-orb-access.ts.
# .agents/setup points the default and really-devrel-sandbox profiles here.
set -euo pipefail

AUDIENCE="urn:amp:aws:bedrock:657166037864:devrel-otel-demo"
ROLE_ARN="arn:aws:iam::657166037864:role/amp-orb-devrel-otel-demo"

if ! command -v amp >/dev/null 2>&1; then
  echo "amp CLI not found. These AWS credentials only work in an Amp orb." >&2
  exit 1
fi

token_file="$(mktemp)"
chmod 600 "$token_file"
trap 'rm -f "$token_file"' EXIT
amp orb id-token --audience "$AUDIENCE" --ttl-seconds 3600 >"$token_file"
[[ -s "$token_file" ]] || { echo "Amp returned an empty OIDC token." >&2; exit 1; }

aws sts assume-role-with-web-identity \
  --role-arn "$ROLE_ARN" \
  --role-session-name "${AMP_THREAD_ID:-amp-orb}" \
  --web-identity-token "file://$token_file" \
  --no-sign-request \
  --output json \
  | jq '{Version: 1, AccessKeyId: .Credentials.AccessKeyId, SecretAccessKey: .Credentials.SecretAccessKey, SessionToken: .Credentials.SessionToken, Expiration: .Credentials.Expiration}'
