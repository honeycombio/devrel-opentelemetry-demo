#!/usr/bin/env bash
# Runs after an orb starts or wakes. Dockerd is not part of the snapshot's
# running processes, so start it again (a no-op if it is already up). The k3d
# cluster is created on demand by .agents/orb-run, not here, to stay fast.
# Also add the demo EKS cluster's kubectl context, which needs the thread's
# Amp OIDC identity that setup doesn't have (see .agents/aws-credential-process).
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
export PATH="$HOME/.local/bin:$PATH"

.agents/orb-docker-up.sh

# update-kubeconfig makes the new context current; keep whatever was current
# (usually k3d-orb, or nothing) so a bare kubectl never lands on the shared cluster.
current=$(kubectl config current-context 2>/dev/null || true)
if aws eks update-kubeconfig --name main-eksCluster-6a6e98a --region eu-west-1 --alias devrel-demo-aws >/dev/null; then
  if [[ -n "$current" ]]; then kubectl config use-context "$current" >/dev/null; else kubectl config unset current-context >/dev/null; fi
else
  echo "Couldn't add the devrel-demo-aws kubectl context (Amp OIDC role not assumable?)." >&2
fi
